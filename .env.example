# FastAPI cookie authentication; use HTTPS for deployed environments.
# Explicit HTTP localhost is accepted for isolated previews and local development.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Existing Supabase project settings, still needed by the SDK-backed workspace.
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-existing-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-existing-project-publishable-key
