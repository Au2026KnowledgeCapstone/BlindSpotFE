# FastAPI cookie authentication; use HTTPS for deployed environments.
# Explicit HTTP localhost is accepted for isolated previews and local development.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Existing Supabase project settings, still needed by the SDK-backed workspace.
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-existing-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-existing-project-publishable-key

# Optional Sentry: blank DSN disables export. NEXT_PUBLIC values are build-time.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional CI-only source-map upload token; NEVER NEXT_PUBLIC.
SENTRY_AUTH_TOKEN=
